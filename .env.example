# ============================================================
# BK_ESTUDO_PROTECAO v2 — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env no repositório.
# ============================================================

# --- Aplicação ---
APP_NAME="BK_Estudo_Protecao"
APP_VERSION="2.0.0"
APP_ENV="development"          # development | production
DEBUG=true
SECRET_KEY="TROQUE_POR_CHAVE_ALEATORIA_DE_64_CHARS"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Banco de dados (Neon PostgreSQL) ---
# Formato: postgresql+asyncpg://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql+asyncpg://bk_user:senha@ep-xxx.us-east-2.aws.neon.tech/bk_estudo_protecao?sslmode=require"
DATABASE_URL_SYNC="postgresql+psycopg2://bk_user:senha@ep-xxx.us-east-2.aws.neon.tech/bk_estudo_protecao?sslmode=require"

# --- CORS ---
ALLOWED_ORIGINS="http://localhost:8000,https://seu-app.railway.app"

# --- Upload e geração de arquivos ---
REPORTS_DIR="./reports_generated"
STATIC_DIR="./static"
TEMPLATES_DIR="./app/templates"
MAX_UPLOAD_SIZE_MB=10

# --- Configurações de engenharia (defaults) ---
DEFAULT_VOLTAGE_FACTOR_C_MAX=1.10
DEFAULT_VOLTAGE_FACTOR_C_MIN=0.95
DEFAULT_FAULT_DURATION_S=0.5
ALGORITHM_VERSION="1.0.0"    # versão do motor de cálculo (rastreabilidade)

# --- Railway (preenchido automaticamente pelo Railway) ---
PORT=8000
RAILWAY_ENVIRONMENT=""
